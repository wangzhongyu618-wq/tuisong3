# ============================================
# docker compose 配置模板（复制为 .env 后填写真实值；.env 已被 .gitignore 排除）
# 部署说明见 deploy/README-DEPLOY.md
# ============================================

# --- 雪球登录态 Cookie：浏览器 F12 -> Network -> 任意请求 -> Cookie 请求头整串 ---
# 格式：xq_a_token=...; xqat=...; xq_r_token=...; xq_id_token=...
XUEQIU_COOKIES=

# --- AI 模型 Key（智谱/DeepSeek/OpenAI 等，与 config.yaml 的 ai.model 配套） ---
AI_API_KEY=

# --- MySQL 密码（config.yaml 的 storage.mysql.password 保持为空） ---
# 容器连宿主机 MySQL 时 MYSQL_HOST 填 host.docker.internal
MYSQL_PASSWORD=
MYSQL_HOST=

# --- 雪球抓取频控（分钟，留空用 config.yaml 默认 120；0=每轮都抓） ---
XUEQIU_INTERVAL_MINUTES=

# ============================================
# Web 服务器配置
# ============================================

# Web 服务器端口（默认 8080，可自定义避免冲突）
# cron 模式下自动启动，通过 http://localhost:{WEBSERVER_PORT} 访问报告
WEBSERVER_PORT=8080
